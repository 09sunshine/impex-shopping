# ==============================================================================
# IMPEX SHOPPING FRONTEND ENVIRONMENT CONFIGURATION
# Stack: React + Vite (SPA)
# ==============================================================================

# For Local Development:
# Set to http://localhost:8000 or leave empty for Vite proxy
VITE_API_URL=http://localhost:8000
VITE_IMPEX_API_BASE_URL=http://localhost:8000

# For Production (Vercel Deployment):
# Configure VITE_API_URL to point to your live Render backend:
# VITE_API_URL=https://impex-shopping-backend.onrender.com
# VITE_IMPEX_API_BASE_URL=https://impex-shopping-backend.onrender.com

# NOTE: Never store merchant API secrets, tokens, or private credentials in frontend environment files.
