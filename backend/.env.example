# ==============================================================================
# IMPEX BACKEND CONFIGURATION TEMPLATE
# Stack: Node.js (LTS) + Express + TypeScript + Supabase PostgreSQL + Better Auth
# ==============================================================================

# Server & Environment
NODE_ENV=development
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://shopping.impexht.com,https://www.impexht.com
COOKIE_DOMAIN=

# Primary Database (Supabase PostgreSQL or standard PostgreSQL)
# For Supabase connection pooler: postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/impex
DATABASE_SSL=false

# Better Auth & JWT Authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_random_auth_secret_here
BETTER_AUTH_URL=http://localhost:8000
JWT_SECRET=your_legacy_or_bearer_jwt_secret_key_here
JWT_EXPIRES_IN_MINUTES=1440

# Google OAuth Integration (Better Auth Social Provider)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Storage (Private screenshot attachment storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=impex-attachments

# Pay'm Payment Gateway (Plop Plop / KashPaw Haiti API: https://plopplop.solutionip.app/)
PAYM_ENABLED=false
PAYM_API_BASE_URL=https://plopplop.solutionip.app
PAYM_CLIENT_ID=
PAYM_MERCHANT_ID=
PAYM_CLIENT_SECRET=
PAYM_WEBHOOK_SECRET=

# PayPal Gateway (Global USD Top-Up & Card Checkout)
# Obtain from PayPal Developer Dashboard: https://developer.paypal.com/dashboard/applications
PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Awin Product Feeds (Authorized Publisher Account)
AWIN_PUBLISHER_ID=
AWIN_API_KEY=
AWIN_FEED_DATA_DIR=uploads/awin_feeds

# Screenshot Upload Restrictions
SCREENSHOT_MAX_FILE_SIZE_MB=10
SCREENSHOT_UPLOAD_DIR=uploads/screenshots

# ------------------------------------------------------------------------------
# Official Merchant APIs (Populate when access is approved)
# Unconfigured adapters automatically route requests to assisted manual procurement.
# ------------------------------------------------------------------------------

# 1. Amazon US (PA-API v5)
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=impex-20
AMAZON_REGION=us-east-1

# 2. eBay US (Buy Browse API v1)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_ENV=SANDBOX

# 3. AliExpress (Open Platform / IOP)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# 4. Walmart US (Walmart IO Developer API)
WALMART_CONSUMER_ID=
WALMART_PRIVATE_KEY=
WALMART_AFFILIATE_PUBLISHER_ID=

# 5. SHEIN US (Assisted Procurement / Affiliate)
SHEIN_AFFILIATE_ID=
SHEIN_API_KEY=

# 6. Fashion Nova (Affiliate)
FASHIONNOVA_AFFILIATE_ID=

# 7. H&M US (Affiliate / Enterprise API)
HM_API_KEY=
HM_AFFILIATE_ID=

# 8. Temu (Affiliate / Assisted Procurement)
TEMU_AFFILIATE_ID=

# ------------------------------------------------------------------------------
# Real Email & OTP Delivery (SMTP / Gmail)
# ------------------------------------------------------------------------------
# For Gmail: set SMTP_SERVICE=gmail, SMTP_USER=your_email@gmail.com, and SMTP_PASS="your 16 char app password"
# For Custom SMTP (SendGrid, Mailgun, AWS SES, Resend): set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="IMPEX International" <noreply@impexht.com>

# ------------------------------------------------------------------------------
# Security & Administrative Controls
# ------------------------------------------------------------------------------
# Designated single administrative account
ADMIN_EMAIL=duguepiterson@gmail.com
