    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/swagger-ui-express": "^4.1.8",
    "better-auth": "^1.1.21",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.3",
    "swagger-ui-express": "^5.0.1",
